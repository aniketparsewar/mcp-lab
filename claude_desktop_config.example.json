{
  "mcpServers": {
    "local-tools": {
      "args": [
        "C:\\path\\to\\mcp-lab\\server\\local_tools_server.py"
      ],
      "command": "python"
    },
    "shipdocchat": {
      "args": [
        "C:\\path\\to\\mcp-lab\\server\\shipdoc_server.py"
